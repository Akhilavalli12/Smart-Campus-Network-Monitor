# Copy to .env and adjust. Never commit .env.
APP_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=campus_noc
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Probing (Stage 2) ---
# Echo requests per probe, wait per reply (seconds), gap between requests (seconds)
PROBE_COUNT=5
PROBE_TIMEOUT_S=1.0
PROBE_INTERVAL_S=0.2
# auto = try icmplib, fall back to the system ping program | icmplib | system
ICMP_BACKEND=auto
# Seed of the simulator's random generator (same seed = same simulated numbers)
SIMULATOR_SEED=42
# Device the monitoring station is plugged into (its vantage point in the topology)
MONITOR_ATTACHED_TO=core-switch

# --- Monitoring engine (Stage 3) ---
# Run the polling loop inside the API process (set false to run the API read-only)
MONITORING_ENABLED=true
# Minimum seconds between cycle starts
POLL_INTERVAL_S=5
# Consecutive failed cycles before a device is declared OFFLINE (detection time = interval x this)
FAILURE_CONFIRMATIONS=3
# Consecutive good cycles before an OFFLINE/UNREACHABLE device is declared ONLINE again
RECOVERY_CONFIRMATIONS=2
# Cycles used to judge DEGRADED (rolling window)
WINDOW_CYCLES=5
# How long measurements are kept (MongoDB TTL index)
MEASUREMENT_RETENTION_HOURS=26

# --- Traffic engine (Stage 4) ---
TRAFFIC_ENABLED=true
# Seconds between traffic samples (rate = counter difference / elapsed time)
TRAFFIC_INTERVAL_S=5
# Network interface of this computer to report as REAL traffic. Empty = all non-loopback interfaces.
# (Examples: eth0, wlan0, "Wi-Fi", "Ethernet")
HOST_NIC=

# --- Alerts and fault simulation (Stages 5-6) ---
ALERTS_ENABLED=true
# Allow fault injection through the API / Simulation page. Set false for a read-only deployment.
SIMULATION_ENABLED=true
